{
  "name": "warehouse_large_v1",
  "purpose": "100 m \u00d7 70 m warehouse exposing 2x2 failure and 8x8 recovery at 15 GHz with 30 dBm gNB TX. Six metal rack rows force 1\u20133 bounce NLOS paths at 54\u201399 m UE distances.",
  "why_current_geometry_fails": "48 m \u00d7 38 m at 30 dBm places all UEs within 25 m of gNB. Sionna constructive multipath gives ~74 dB path loss (10 dB better than FSPL). Even 2\u00d72 gets +32 dB SNR \u2014 saturated at max MCS. No array size or ISAC change can improve a ceiling-pegged link.",
  "key_design_decisions": {
    "gnb_tx_power_dbm": 30,
    "warehouse_size_m": "100 x 70",
    "gnb_position": "SW corner [-48,-33,6] \u2014 maximises path-length spread",
    "rack_rows": "6 rows at X=\u221232,\u221218,\u22124,+10,+24,+38; run N-S; 2m wide, 4.5m tall",
    "target_nlos_at_challenge_ue": "+10 dB vs FSPL (1-bounce off metal rack or ceiling). At 80 m + 10 dB NLOS: PL=104 dB, 2x2 SNR=2 dB (fail), 8x8 SNR=11.5 dB (functional). The 9.5 dB array gain gap drives both throughput and sensing improvement."
  },
